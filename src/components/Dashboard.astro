---
import { DASHBOARD_METRICS } from '../data/site';

interface Props {
  score?: number;
  insight?: string;
  compact?: boolean;
}
const {
  score = 71,
  insight = 'Your strongest opportunity may not be additional capital. It may be creating more monthly flexibility before pursuing it.',
  compact = false,
} = Astro.props;

const R = 34;
const C = 2 * Math.PI * R;
---

<div class="relative">
  <div
    id="ksm-dashboard"
    class="relative rounded-[1.5rem] border border-line bg-cream p-6 shadow-[0_2px_4px_rgba(15,29,51,.04),0_32px_64px_-28px_rgba(15,29,51,.28)] sm:p-8"
  >
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="label text-ink-400">KSM Financial Profile</p>
        <p class="mt-3 font-display text-[2.75rem] leading-none font-extrabold tabular-nums text-ink-900">
          <span data-countup={score}>0</span><span class="ml-1 text-xl font-bold text-ink-400">/100</span>
        </p>
        <p class="mt-2 text-[0.8125rem] font-medium text-ink-500">Overall position · Developing</p>
      </div>

      <div class="relative h-[86px] w-[86px] flex-none">
        <svg viewBox="0 0 86 86" class="h-full w-full -rotate-90" aria-hidden="true">
          <circle cx="43" cy="43" r={R} fill="none" stroke="#E4E8EF" stroke-width="7" />
          <circle
            id="score-ring"
            cx="43"
            cy="43"
            r={R}
            fill="none"
            stroke="#2B57F0"
            stroke-width="7"
            stroke-linecap="round"
            stroke-dasharray={C}
            stroke-dashoffset={C}
            data-target={C - (C * score) / 100}
            style="transition: stroke-dashoffset 1.4s cubic-bezier(.2,.7,.3,1)"
          />
        </svg>
        <span
          class="label absolute inset-0 grid place-items-center text-ink-500"
          >Prep</span
        >
      </div>
    </div>

    <div class="mt-7 border-t border-line pt-6">
      <ul class="space-y-[1.125rem]">
        {
          DASHBOARD_METRICS.map((m) => (
            <li>
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-[0.875rem] font-medium text-ink-800">{m.label}</span>
                <span class="num flex items-center gap-2 text-[0.75rem]">
                  <span class={m.tone === 'good' ? 'text-good font-semibold' : 'text-warn font-semibold'}>
                    {m.value}%
                  </span>
                  <span class="text-ink-300" aria-hidden="true">
                    ·
                  </span>
                  <span class={m.tone === 'good' ? 'text-good' : 'text-warn'}>{m.status}</span>
                </span>
              </div>
              <div class="mt-2 h-[5px] w-full overflow-hidden rounded-full bg-ink-100">
                <div
                  class="h-full rounded-full"
                  data-bar={m.value}
                  style={`width:0%;background:${m.tone === 'good' ? '#2F9E68' : '#C98A22'};transition:width 1.1s cubic-bezier(.2,.7,.3,1)`}
                />
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    {
      !compact && (
        <div class="mt-7 rounded-2xl border border-brand-100 bg-brand-50/70 p-5">
          <p class="label flex items-center gap-2 text-brand-700">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M1.5 9.5 5 6l2.5 2.5L12.5 3.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path d="M9.5 3.5h3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            KSM Insight
          </p>
          <p class="mt-2.5 text-[0.9375rem] font-medium leading-relaxed text-ink-800">{insight}</p>
        </div>
      )
    }
  </div>

  <div
    class="absolute -bottom-5 left-4 hidden items-center gap-2.5 rounded-full border border-line bg-white px-4 py-3 shadow-[0_12px_32px_-16px_rgba(15,29,51,.35)] sm:flex"
  >
    <span class="grid h-6 w-6 place-items-center rounded-full bg-good-soft" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path d="M2.5 6.2 4.8 8.5 9.5 3.8" stroke="#2F9E68" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="text-[0.8125rem] font-medium text-ink-800">Profile snapshot complete</span>
  </div>

  <p class="mt-8 text-[0.75rem] leading-relaxed text-ink-400">
    Illustrative example. KSM does not provide a universal credit score and does not guarantee financing
    outcomes.
  </p>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById('ksm-dashboard');
    if (!root) return;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function run() {
      root.querySelectorAll('[data-bar]').forEach(function (el, i) {
        var v = el.getAttribute('data-bar');
        setTimeout(function () { el.style.width = v + '%'; }, reduce ? 0 : 90 * i);
      });
      var ring = root.querySelector('#score-ring');
      if (ring) setTimeout(function () { ring.style.strokeDashoffset = ring.getAttribute('data-target'); }, reduce ? 0 : 120);

      root.querySelectorAll('[data-countup]').forEach(function (el) {
        var target = parseInt(el.getAttribute('data-countup'), 10);
        if (reduce) { el.textContent = String(target); return; }
        var start = performance.now(), dur = 1200;
        function tick(now) {
          var p = Math.min((now - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    }

    if (!('IntersectionObserver' in window)) return run();
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { run(); io.disconnect(); }
        });
      },
      { threshold: 0.25 }
    );
    io.observe(root);
  })();
</script>
