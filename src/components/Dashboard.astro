---
import {
  COMPONENTS,
  BANDS,
  COMPONENT_STATUS,
  bandFor,
  statusFor,
  indexOf,
  scoreOf,
  segmentsOf,
  STRONG_INSIGHT,
} from '../data/profile';

interface Props {
  /** Let the visitor drag each component and watch the score and insight change. */
  interactive?: boolean;
  /** Override the starting component values (same order as COMPONENTS). */
  values?: number[];
  /** Force a fixed insight instead of deriving it from the weakest component. */
  insight?: string;
}

const { interactive = false, values, insight } = Astro.props;

const components = COMPONENTS.map((c, i) => ({ ...c, value: values?.[i] ?? c.value }));
const raw = components.map((c) => c.value);
const band = bandFor(indexOf(raw));
const score = scoreOf(raw);
const lit = segmentsOf(raw);

const weakest = components.reduce((a, b) => (b.value < a.value ? b : a));
const startingInsight = insight ?? (weakest.value >= 80 ? STRONG_INSIGHT : weakest.insight);

// Ten-segment dial: the shape itself says "out of ten".
const R = 34;
const C = 2 * Math.PI * R;
const SEG = C / 10;
const GAP = 5;
const DASH = SEG - GAP;
const SEGMENTS = Array.from({ length: 10 }, (_, i) => i);

const config = { bands: BANDS, status: COMPONENT_STATUS, strongInsight: STRONG_INSIGHT, components };
---

<div>
  <div class="relative">
    <div
      id="ksm-dashboard"
      data-interactive={interactive ? 'true' : 'false'}
      class="relative rounded-[1.5rem] border border-line bg-cream p-5 shadow-[0_2px_4px_rgba(15,29,51,.04),0_32px_64px_-28px_rgba(15,29,51,.28)] min-[400px]:p-6 sm:p-7"
    >
      <div class="flex items-start justify-between gap-4 sm:gap-6">
        <div class="min-w-0">
          <p class="label text-ink-400">KSM Profile Score</p>

          <p class="mt-2.5 flex items-baseline gap-1">
            <span
              id="score-value"
              class="font-display text-[2.25rem] leading-none font-extrabold tabular-nums text-ink-900 sm:text-[2.75rem]"
              >{score}</span
            >
            <span class="font-display text-[1.125rem] font-bold leading-none text-ink-400">/10</span>
          </p>

          <p class="mt-2 text-[0.8125rem] font-medium text-ink-500">
            <span id="band-label" class="font-semibold text-ink-700">{band.label}</span>
            <span class="text-ink-300" aria-hidden="true"> · </span>
            <span class="text-ink-400">10 is strongest</span>
          </p>
        </div>

        <div class="relative h-[60px] w-[60px] flex-none sm:h-[76px] sm:w-[76px]">
          <svg viewBox="0 0 86 86" class="h-full w-full -rotate-90" aria-hidden="true">
            {
              SEGMENTS.map((i) => (
                <circle
                  cx="43"
                  cy="43"
                  r={R}
                  fill="none"
                  stroke={i < lit ? '#2B57F0' : '#E4E8EF'}
                  stroke-width="7"
                  stroke-linecap="butt"
                  stroke-dasharray={`${DASH} ${C - DASH}`}
                  stroke-dashoffset={-i * SEG}
                  data-seg={i}
                  style="transition: stroke .25s ease"
                />
              ))
            }
          </svg>
        </div>
      </div>

      <p id="band-note" class="mt-4 text-[0.78125rem] leading-snug text-ink-500">{band.note}</p>

      <div class="mt-5 border-t border-line pt-5">
        <ul class="space-y-3">
          {
            components.map((c) => {
              const s = statusFor(c.value);
              return (
                <li data-row={c.key}>
                  <div class="flex items-baseline justify-between gap-3">
                    <label
                      for={`range-${c.key}`}
                      class="text-[0.875rem] font-medium text-ink-800"
                      set:text={c.label}
                    />
                    <span class="num flex items-center gap-2 text-[0.75rem]">
                      <span data-value class="font-semibold text-ink-700">{c.value}</span>
                      <span class="text-ink-300" aria-hidden="true">
                        ·
                      </span>
                      <span
                        data-status
                        class:list={[
                          s.tone === 'good' ? 'text-good' : s.tone === 'bad' ? 'text-bad' : 'text-warn',
                        ]}
                      >
                        {s.label}
                      </span>
                    </span>
                  </div>

                  <input
                    id={`range-${c.key}`}
                    type="range"
                    min="0"
                    max="100"
                    step="1"
                    value={c.value}
                    data-range={c.key}
                    aria-label={`${c.label} — illustrative strength, 0 to 100`}
                    class:list={['ksm-range mt-1', !interactive && 'is-static']}
                    tabindex={interactive ? undefined : -1}
                  />
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="mt-5 rounded-2xl border border-brand-100 bg-brand-50/70 p-4">
        <p class="label flex items-center gap-2 text-brand-700">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path
              d="M1.5 9.5 5 6l2.5 2.5L12.5 3.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M9.5 3.5h3v3"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          KSM Insight
        </p>
        <p
          id="ksm-insight"
          class="mt-2 text-[0.875rem] font-medium leading-snug text-ink-800"
          aria-live="polite"
        >
          {startingInsight}
        </p>
      </div>

      {
        interactive && (
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <p class="text-[0.75rem] text-ink-500">Drag any row to model a different position.</p>
            <button
              type="button"
              id="ksm-reset"
              class="label rounded-full border border-line bg-white px-3 py-1.5 text-ink-500 transition-colors hover:border-brand-300 hover:text-brand-700"
            >
              Reset
            </button>
          </div>
        )
      }
    </div>

    <div
      class="absolute -bottom-5 left-4 hidden items-center gap-2.5 rounded-full border border-line bg-white px-4 py-3 shadow-[0_12px_32px_-16px_rgba(15,29,51,.35)] sm:flex"
    >
      <span class="grid h-6 w-6 place-items-center rounded-full bg-good-soft" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path
            d="M2.5 6.2 4.8 8.5 9.5 3.8"
            stroke="#2F9E68"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="text-[0.8125rem] font-medium text-ink-800">
        {interactive ? 'Interactive — try it' : 'Profile snapshot complete'}
      </span>
    </div>
  </div>

  <p class="mt-6 text-[0.6875rem] leading-snug text-ink-500 sm:mt-8">
    Illustrative model. The KSM Profile Score is a 0–10 KSM measure, not a credit score and not a
    prediction of any lending decision.
  </p>
</div>

<script type="application/json" id="ksm-profile-config" is:inline set:html={JSON.stringify(config)} />

<script is:inline>
  (function () {
    var root = document.getElementById('ksm-dashboard');
    var cfgEl = document.getElementById('ksm-profile-config');
    if (!root || !cfgEl) return;

    var cfg = JSON.parse(cfgEl.textContent);
    var interactive = root.getAttribute('data-interactive') === 'true';
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    var TONE = { good: '#2F9E68', warn: '#C98A22', bad: '#B4483C' };
    var TONE_CLASS = { good: 'text-good', warn: 'text-warn', bad: 'text-bad' };

    var segs = root.querySelectorAll('[data-seg]');
    var scoreEl = root.querySelector('#score-value');
    var bandLabel = root.querySelector('#band-label');
    var bandNote = root.querySelector('#band-note');
    var insightEl = root.querySelector('#ksm-insight');

    var rows = cfg.components.map(function (c) {
      return {
        key: c.key,
        insight: c.insight,
        target: c.value,
        input: root.querySelector('[data-range="' + c.key + '"]'),
        li: root.querySelector('[data-row="' + c.key + '"]'),
      };
    });

    function statusFor(v) {
      for (var i = 0; i < cfg.status.length; i++) if (v >= cfg.status[i].min) return cfg.status[i];
      return cfg.status[cfg.status.length - 1];
    }
    function bandFor(v) {
      for (var i = 0; i < cfg.bands.length; i++) if (v >= cfg.bands[i].min) return cfg.bands[i];
      return cfg.bands[cfg.bands.length - 1];
    }

    function paintRow(row) {
      var v = Number(row.input.value);
      var s = statusFor(v);
      var colour = TONE[s.tone];
      row.input.style.setProperty(
        '--track',
        'linear-gradient(to right, ' + colour + ' ' + v + '%, #E9EDF3 ' + v + '%)'
      );
      row.input.style.setProperty('--thumb', colour);
      row.li.querySelector('[data-value]').textContent = String(v);
      var statusEl = row.li.querySelector('[data-status]');
      statusEl.textContent = s.label;
      statusEl.className = TONE_CLASS[s.tone];
    }

    function paintOverall() {
      var values = rows.map(function (r) {
        return Number(r.input.value);
      });
      var mean =
        values.reduce(function (a, b) {
          return a + b;
        }, 0) / values.length;
      var index = Math.round(mean);
      var band = bandFor(index);

      if (scoreEl) scoreEl.textContent = (index / 10).toFixed(1);
      var lit = Math.round(index / 10);
      segs.forEach(function (s, i) {
        s.setAttribute('stroke', i < lit ? '#2B57F0' : '#E4E8EF');
      });

      if (bandLabel) bandLabel.textContent = band.label;
      if (bandNote) bandNote.textContent = band.note;

      var weakest = rows[0];
      rows.forEach(function (r) {
        if (Number(r.input.value) < Number(weakest.input.value)) weakest = r;
      });
      var text = Number(weakest.input.value) >= 80 ? cfg.strongInsight : weakest.insight;
      if (insightEl && insightEl.textContent.trim() !== text) insightEl.textContent = text;
    }

    function paintAll() {
      rows.forEach(paintRow);
      paintOverall();
    }

    // ---- intro: slide each row up to its starting value -------------------
    var introRunning = false;

    function intro() {
      if (reduce) {
        rows.forEach(function (r) {
          r.input.value = String(r.target);
        });
        paintAll();
        return;
      }
      introRunning = true;
      var start = performance.now();
      var dur = 950;
      function tick(now) {
        if (!introRunning) return;
        var p = Math.min((now - start) / dur, 1);
        var eased = 1 - Math.pow(1 - p, 3);
        rows.forEach(function (r) {
          r.input.value = String(Math.round(r.target * eased));
        });
        paintAll();
        if (p < 1) requestAnimationFrame(tick);
        else introRunning = false;
      }
      rows.forEach(function (r) {
        r.input.value = '0';
      });
      paintAll();
      requestAnimationFrame(tick);
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              intro();
              io.disconnect();
            }
          });
        },
        { threshold: 0.25 }
      );
      io.observe(root);
    } else {
      intro();
    }

    if (!interactive) return;

    var tracked = false;
    rows.forEach(function (row) {
      row.input.addEventListener('input', function () {
        introRunning = false; // a drag always wins over the intro
        paintRow(row);
        paintOverall();
        if (!tracked && window.ksm) {
          tracked = true;
          window.ksm.track('dashboard_interact');
        }
      });
    });

    var reset = document.getElementById('ksm-reset');
    if (reset) {
      reset.addEventListener('click', function () {
        introRunning = false;
        rows.forEach(function (r) {
          r.input.value = String(r.target);
        });
        paintAll();
        if (window.ksm) window.ksm.track('dashboard_reset');
      });
    }
  })();
</script>
