---
import { PILLARS } from '../data/site';
interface Props {
  heading?: string;
  lede?: string;
  eyebrow?: string;
}
const {
  eyebrow = 'The KSM Financial Profile',
  heading = 'Your financial position has six moving parts.',
  lede = 'Each one is measurable. None of them means much on its own. The profile is what happens when you look at all six together.',
} = Astro.props;
---

<section id="pillars" class="wrap mt-24 scroll-mt-24">
  <div class="max-w-2xl">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h2 class="reveal mt-6 text-[2rem] leading-tight sm:text-[2.5rem]" data-delay="60">{heading}</h2>
    <p class="reveal mt-5 text-[1.0625rem] leading-relaxed text-ink-600" data-delay="120">{lede}</p>
  </div>

  <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      PILLARS.map((p, i) => (
        <article class="card card-hover reveal group flex flex-col p-7" data-delay={(i % 3) * 70}>
          <div class="flex items-center justify-between">
            <span class="num text-[0.8125rem] font-medium tracking-[0.1em] text-brand-600">{p.num}</span>
            <span
              class="h-8 w-8 rounded-lg border border-line transition-colors duration-300 group-hover:border-brand-200 group-hover:bg-brand-50"
              aria-hidden="true"
            />
          </div>
          <h3 class="mt-5 text-[1.25rem] leading-snug">{p.title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-600">{p.short}</p>

          <ul class="mt-5 space-y-2 border-t border-line pt-5">
            {p.points.map((pt) => (
              <li class="flex items-start gap-2.5 text-[0.8125rem] leading-relaxed text-ink-500">
                <span class="mt-[0.45rem] h-1 w-1 flex-none rounded-full bg-brand-400" aria-hidden="true" />
                {pt}
              </li>
            ))}
          </ul>

          <a
            href={p.href}
            class="mt-6 inline-flex items-center gap-1.5 text-[0.875rem] font-semibold text-brand-700 transition-transform duration-200 hover:gap-2.5"
          >
            Read more <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
