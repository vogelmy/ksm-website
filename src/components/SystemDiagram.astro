---
const NODES = [
  { id: 'income', label: 'Income', note: 'What arrives, how reliably' },
  { id: 'cash-flow', label: 'Cash Flow', note: 'What is left after commitments' },
  { id: 'debt', label: 'Debt', note: 'Cost, shape and timing' },
  { id: 'credit', label: 'Credit', note: 'Exposure and utilization' },
  { id: 'liquidity', label: 'Liquidity', note: 'Room to absorb a shock' },
  { id: 'capital', label: 'Capital', note: 'The objective ahead' },
  { id: 'timing', label: 'Timing', note: 'When the move happens' },
];
---

<section class="relative mt-24 overflow-hidden border-y border-line bg-ink-950 py-20 md:py-28">
  <div
    class="grid-bg pointer-events-none absolute inset-0 opacity-[0.14] [background-image:linear-gradient(to_right,rgba(255,255,255,.5)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,.5)_1px,transparent_1px)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute left-1/2 top-[-14rem] h-[760px] w-[760px] -translate-x-1/2 rounded-full border border-white/[0.07]"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow reveal justify-center !text-brand-300 before:!bg-brand-400">The big idea</p>
      <h2 class="reveal mt-6 text-[2rem] leading-tight text-white sm:text-[2.75rem]" data-delay="60">
        Most people look at their finances one account at a time.
      </h2>
      <p
        class="reveal mt-6 font-display text-[1.5rem] font-extrabold leading-tight text-brand-300 sm:text-[2rem]"
        data-delay="120"
      >
        KSM looks at the system.
      </p>
    </div>

    <div class="reveal mt-16" data-delay="180">
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          NODES.map((n, i) => (
            <li
              class="group relative rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition-colors duration-300 hover:border-brand-400/50 hover:bg-white/[0.07]"
              data-node={n.id}
            >
              <span class="num text-[0.6875rem] text-ink-500">{String(i + 1).padStart(2, '0')}</span>
              <p class="mt-2 font-display text-[1.0625rem] font-extrabold text-white">{n.label}</p>
              <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-ink-400">{n.note}</p>
              <span
                class="absolute inset-x-5 bottom-0 h-[2px] origin-left scale-x-0 rounded-full bg-brand-400 transition-transform duration-300 group-hover:scale-x-100"
                aria-hidden="true"
              />
            </li>
          ))
        }
        <li class="rounded-2xl border border-brand-400/40 bg-brand-600/15 p-5">
          <span class="label text-brand-300">Result</span>
          <p class="mt-2 font-display text-[1.0625rem] font-extrabold text-white">Your position</p>
          <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-brand-100/80">
            The relationship between all seven
          </p>
        </li>
      </ol>
    </div>

    <p class="reveal mx-auto mt-14 max-w-2xl text-center text-[1.0625rem] leading-relaxed text-ink-300" data-delay="240">
      A strong financial position is not determined by one number. It is determined by the relationship
      between the numbers — and by whether that relationship supports what you are trying to do next.
    </p>
  </div>
</section>
