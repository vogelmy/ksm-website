---
import { COMPONENTS, bandFor, indexOf } from '../data/profile';

const BARS = COMPONENTS.map((c) => ({ label: c.label, pct: c.value }));
const INDEX = indexOf(BARS.map((b) => b.pct));
const BAND = bandFor(INDEX);

const ROADMAP = [
  { num: '01', title: 'Stabilize', window: 'Days 1–30', body: 'Rebuild a reserve floor and remove the two obligations creating the most monthly pressure.' },
  { num: '02', title: 'Optimize', window: 'Days 15–45', body: 'Restructure payment shape and reduce utilization on the lines that carry the most weight.' },
  { num: '03', title: 'Build', window: 'Days 30–75', body: 'Grow liquidity toward the target coverage and let the profile season.' },
  { num: '04', title: 'Prepare', window: 'Days 60–90', body: 'Assemble documentation and approach financing from a position that supports the request.' },
];
---

<section id="deliverable" class="wrap mt-24 scroll-mt-24">
  <div class="max-w-2xl">
    <p class="eyebrow reveal">What you receive</p>
    <h2 class="reveal mt-6 text-[2rem] leading-tight sm:text-[2.5rem]" data-delay="60">
      Leave with a roadmap — not another opinion.
    </h2>
    <p class="reveal mt-5 text-[1.0625rem] leading-relaxed text-ink-600" data-delay="120">
      KSM turns a complicated financial picture into a prioritized strategy: what matters now, what should
      wait, and which moves support the larger objective.
    </p>
  </div>

  <div class="mt-14 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
    <!-- The report mockup -->
    <div class="reveal">
      <div class="overflow-hidden rounded-[1.5rem] border border-line bg-white shadow-[var(--shadow-lift)]">
        <div class="flex items-center justify-between border-b border-line bg-ink-950 px-7 py-5">
          <div>
            <p class="font-display text-sm font-extrabold tracking-[0.2em] text-white">KSM</p>
            <p class="label mt-1 text-ink-400">Financial Profile</p>
          </div>
          <span class="label rounded-full border border-white/15 px-3 py-1.5 text-ink-300">
            Private &amp; Confidential
          </span>
        </div>

        <div class="px-7 py-7">
          <div class="flex items-end justify-between gap-6 border-b border-line pb-6">
            <div>
              <p class="label text-ink-400">Position Index</p>
              <div class="mt-2 flex items-end gap-3">
                <span class="font-display text-[3rem] leading-none font-extrabold text-ink-900">
                  {BAND.letter}
                </span>
                <span class="pb-1 font-display text-[1.125rem] font-extrabold leading-none text-ink-700">
                  {BAND.label}
                </span>
              </div>
            </div>
            <p class="pb-1 text-right text-[0.8125rem] font-medium text-ink-500">
              Band A–E<br /><span class="text-ink-400">Prepared 14 Aug 2026</span>
            </p>
          </div>

          <ul class="mt-6 space-y-4">
            {
              BARS.map((b) => (
                <li>
                  <div class="flex items-baseline justify-between">
                    <span class="text-[0.8125rem] font-medium text-ink-700">{b.label}</span>
                    <span class="num text-[0.6875rem] text-ink-500">{b.pct}%</span>
                  </div>
                  <div class="mt-2 flex gap-[3px]" aria-hidden="true">
                    {Array.from({ length: 14 }).map((_, i) => (
                      <span
                        class:list={[
                          'h-[7px] flex-1 rounded-[2px]',
                          i < Math.round((b.pct / 100) * 14) ? 'bg-ink-900' : 'bg-ink-100',
                        ]}
                      />
                    ))}
                  </div>
                </li>
              ))
            }
          </ul>

          <div class="mt-7 rounded-xl border border-brand-100 bg-brand-50/70 p-5">
            <p class="label text-brand-700">Top priority</p>
            <p class="mt-2 font-display text-[1.0625rem] font-extrabold leading-snug text-ink-900">
              Increase monthly liquidity before adding new obligations.
            </p>
          </div>
        </div>
      </div>
      <p class="mt-5 text-[0.75rem] leading-relaxed text-ink-500">
        Illustrative example. Figures shown do not represent an actual client or an actual result.
      </p>
    </div>

    <!-- The 90-day roadmap -->
    <div class="reveal rounded-[1.5rem] border border-line bg-cream p-7 md:p-8" data-delay="120">
      <p class="label text-ink-400">The next ninety days</p>
      <h3 class="mt-3 text-[1.375rem] leading-snug">A sequence, not a to-do list.</h3>

      <ol class="mt-8 space-y-7">
        {
          ROADMAP.map((r) => (
            <li class="relative pl-11">
              <span
                class="num absolute left-0 top-0 grid h-8 w-8 place-items-center rounded-full border border-line bg-white text-[0.6875rem] font-medium text-brand-600"
                aria-hidden="true"
              >
                {r.num}
              </span>
              <div class="flex flex-wrap items-baseline gap-x-3">
                <h4 class="text-[1.0625rem]">{r.title}</h4>
                <span class="label text-ink-400">{r.window}</span>
              </div>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-600">{r.body}</p>
            </li>
          ))
        }
      </ol>

      <a href="/start" class="btn btn-primary mt-9 w-full" data-ev="deliverable_cta_click">
        Start my financial profile <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
