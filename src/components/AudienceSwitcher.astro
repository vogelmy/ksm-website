---
const PANELS = {
  individuals: {
    label: 'Individuals & Families',
    headline: 'A personal position is rarely just one decision.',
    body: 'A mortgage, a car, a renovation, tuition, an inherited obligation — each one gets evaluated on its own, and the combined effect never gets looked at. That combined effect is what determines what you can actually do next.',
    items: [
      { t: 'Mortgage & refinance', d: 'What the position needs to look like before the application.' },
      { t: 'Personal debt', d: 'Which obligations to address first, and which to leave alone.' },
      { t: 'Credit exposure', d: 'Utilization, history and how the profile reads to a lender.' },
      { t: 'Income structure', d: 'How income is documented, not just how much it is.' },
      { t: 'Liquidity', d: 'A reserve target sized to your actual obligations.' },
      { t: 'Major purchases', d: 'Sequencing a large decision so it does not undo the rest.' },
    ],
    href: '/individuals',
  },
  business: {
    label: 'Business Owners',
    headline: 'The wall between business and personal is thinner than it looks.',
    body: 'Personal guarantees, owner draws, blended credit and seasonal revenue mean the two positions move together. A profile that ignores one side gives you an answer to the wrong question.',
    items: [
      { t: 'Operating cash flow', d: 'What the business actually produces after obligations.' },
      { t: 'Business debt', d: 'Cost, shape, concentration and renewal timing.' },
      { t: 'Personal guarantees', d: 'Where business obligations sit on the personal position.' },
      { t: 'Credit exposure', d: 'Business and personal utilization, viewed together.' },
      { t: 'Working capital', d: 'Coverage through the seasonal or collection cycle.' },
      { t: 'Growth capital', d: 'What the position needs before the raise, not after.' },
    ],
    href: '/business',
  },
};
const keys = Object.keys(PANELS) as (keyof typeof PANELS)[];
---

<section id="audience" class="wrap mt-24 scroll-mt-24">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="eyebrow reveal">Who KSM helps</p>
      <h2 class="reveal mt-6 text-[2rem] leading-tight sm:text-[2.5rem]" data-delay="60">
        Who are you planning for?
      </h2>
    </div>

    <div
      class="reveal inline-flex flex-none rounded-full border border-line bg-ink-50 p-1"
      role="tablist"
      aria-label="Audience"
      data-delay="120"
    >
      {
        keys.map((k, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${k}`}
            aria-controls={`panel-${k}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-aud-tab={k}
            data-ev={k === 'individuals' ? 'individual_click' : 'business_click'}
            class="rounded-full px-5 py-2.5 text-[0.875rem] font-semibold text-ink-500 transition-colors aria-selected:bg-white aria-selected:text-ink-900 aria-selected:shadow-[0_1px_2px_rgba(15,29,51,.08)]"
          >
            {PANELS[k].label}
          </button>
        ))
      }
    </div>
  </div>

  {
    keys.map((k, i) => (
      <div
        id={`panel-${k}`}
        role="tabpanel"
        aria-labelledby={`tab-${k}`}
        data-aud-panel={k}
        hidden={i !== 0}
        class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-16"
      >
        <div>
          <h3 class="text-[1.5rem] leading-snug">{PANELS[k].headline}</h3>
          <p class="mt-5 text-[1.0625rem] leading-relaxed text-ink-600">{PANELS[k].body}</p>
          <a href={PANELS[k].href} class="btn btn-ghost mt-8">
            Explore this track <span aria-hidden="true">→</span>
          </a>
        </div>

        <ul class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
          {PANELS[k].items.map((item) => (
            <li class="bg-white p-6">
              <h4 class="text-[1rem] leading-snug">{item.t}</h4>
              <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-500">{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<script is:inline>
  (function () {
    var tabs = document.querySelectorAll('[data-aud-tab]');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var key = tab.getAttribute('data-aud-tab');
        tabs.forEach(function (t) {
          t.setAttribute('aria-selected', String(t === tab));
        });
        document.querySelectorAll('[data-aud-panel]').forEach(function (p) {
          p.hidden = p.getAttribute('data-aud-panel') !== key;
        });
      });
    });
  })();
</script>
