---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { SITE } from '../data/site';

const BELIEFS = [
  {
    t: 'The relationship between the numbers is the number',
    d: 'Single-metric thinking is what makes financial decisions feel unpredictable. Almost every surprise we see traces back to a component that was strong on its own and badly matched to the ones around it.',
  },
  {
    t: 'Independence is a structural choice, not a claim',
    d: 'KSM does not lend, broker, or accept compensation from lenders. That is not a marketing position — it is what makes it possible to recommend doing nothing yet.',
  },
  {
    t: 'Sequence is the deliverable',
    d: 'Most clients can already list what could be improved. What they do not have is an order, and the order is where the value is.',
  },
  {
    t: 'Say what cannot be promised',
    d: 'Approvals, rates, limits, score movements and savings are outside anyone’s control but the lender’s. A practice that pretends otherwise is a sales operation.',
  },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Motti Kallus',
  jobTitle: 'Founder',
  worksFor: { '@type': 'Organization', name: SITE.name },
  email: SITE.email,
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Boca Raton',
    addressRegion: 'FL',
    addressCountry: 'US',
  },
  description:
    'Founder of Kallus Strategic Management, with more than a decade across business operations, strategy, sales and organizational growth. Works with business owners on cash flow, debt structure and how their financial position reads to a lender.',
};

const NOTLIST = [
  ['Not a lender or bank', 'KSM does not originate, fund or service loans of any kind.'],
  ['Not a loan broker or originator', 'KSM does not submit applications and takes no lender compensation.'],
  ['Not a credit repair organization', 'KSM does not dispute credit report entries or promise score changes.'],
  ['Not a debt settlement company', 'KSM does not negotiate with creditors or enroll clients in relief programs.'],
  ['Not a credit reporting agency', 'KSM does not furnish, sell or produce consumer credit reports or scores.'],
  ['Not an investment adviser or accountant', 'KSM does not manage assets or provide tax, audit or legal advice.'],
];
---

<Base
  title="About KSM | Kallus Strategic Management"
  description="Kallus Strategic Management is an independent financial strategy practice in Boca Raton, founded by Motti Kallus. Not a lender, broker or credit repair firm."
  path="/about"
  schema={[personSchema]}
>
  <PageHero
    eyebrow="About KSM"
    title="An independent practice built around one question: what does this position actually support?"
    lede="Kallus Strategic Management analyzes complete financial positions — for individuals and for business owners — and produces a prioritized strategy. There is no product at the end of the recommendation, which is the entire point."
  />

  <section class="wrap mt-20">
    <div class="prose-ksm reveal max-w-3xl">
      <h2>Why the practice exists</h2>
      <p>
        Nearly everyone offering financial guidance is attached to a product. Lenders are attached to
        loans, brokers to placements, relief companies to enrollments, advisers to assets under
        management. Each of those can be legitimate and useful. None of them is well positioned to tell
        you that the right move this quarter is to change nothing and wait.
      </p>
      <p>
        KSM was set up to occupy that gap. The engagement produces analysis and a sequence. Execution
        stays with you and whichever institutions or professionals you choose to work with. Because no
        product sits on the other side of the recommendation, the recommendation can be whatever the
        position actually calls for.
      </p>

      <h3>How we work</h3>
      <p>
        Every engagement runs the same five steps in the same order, and produces the same four outputs:
        a written profile, a stated top priority, a ninety-day roadmap, and an explicit list of what to
        leave alone. Consistency is deliberate — it makes the output comparable over time, and it keeps
        the recommendation from depending on who happens to be in the room.
      </p>

      <h3>What we ask of clients</h3>
      <p>
        Candor, mostly. The engagement is only as good as the picture it is built on, and the components
        people are least eager to discuss are usually the ones doing the most damage. Information is
        handled with discretion, used solely to build and discuss the profile, and never sold or shared
        with lenders for marketing.
      </p>
    </div>
  </section>

  <section class="wrap mt-20">
    <div class="max-w-2xl">
      <p class="eyebrow reveal">What we believe</p>
      <h2 class="reveal mt-6 text-[2rem] leading-tight sm:text-[2.5rem]" data-delay="60">
        Four positions that shape every engagement.
      </h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        BELIEFS.map((b, i) => (
          <div class="card reveal p-8" data-delay={(i % 2) * 70}>
            <h3 class="text-[1.125rem] leading-snug">{b.t}</h3>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-600">{b.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap mt-24">
    <div class="rounded-[2rem] bg-ink-950 px-6 py-14 sm:px-12 md:py-16">
      <div class="max-w-2xl">
        <p class="eyebrow reveal !text-brand-300 before:!bg-brand-400">Plainly stated</p>
        <h2 class="reveal mt-6 text-[1.875rem] leading-tight text-white sm:text-[2.25rem]" data-delay="60">
          What KSM is not.
        </h2>
        <p class="reveal mt-5 text-[1.0625rem] leading-relaxed text-ink-300" data-delay="120">
          This list matters more than most of what a firm can say about itself, because it defines what
          the advice cannot be shaped by.
        </p>
      </div>

      <ul class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-2">
        {
          NOTLIST.map(([t, d]) => (
            <li class="bg-ink-950 p-6">
              <h3 class="text-[1rem] text-white">{t}</h3>
              <p class="mt-2 text-[0.875rem] leading-relaxed text-ink-400">{d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Founder -->
  <section class="wrap mt-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
      <div>
        <p class="eyebrow reveal">Who you work with</p>
        <div class="reveal mt-8 overflow-hidden rounded-[1.5rem] border border-line bg-cream" data-delay="60">
          <div class="grid aspect-[4/5] place-items-center bg-ink-50 text-ink-300" aria-hidden="true">
            <svg width="52" height="52" viewBox="0 0 52 52" fill="none">
              <circle cx="26" cy="19" r="9" stroke="currentColor" stroke-width="2" />
              <path d="M9 45c0-8.8 7.6-14 17-14s17 5.2 17 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </div>
          <div class="p-6">
            <p class="font-display text-[1.125rem] font-extrabold text-ink-900">Motti Kallus</p>
            <p class="label mt-2 text-ink-400">Founder · Boca Raton, FL</p>
            <div class="mt-5 space-y-1.5 border-t border-line pt-5">
              <a
                href={`mailto:${SITE.email}`}
                class="block break-words text-[0.875rem] font-medium text-brand-700 underline underline-offset-4 break-address"
                data-ev="email_click">{SITE.email}</a
              >
              <a
                href={`tel:${SITE.phone}`}
                class="block text-[0.875rem] font-medium text-brand-700 underline underline-offset-4"
                data-ev="phone_click">{SITE.phoneDisplay}</a
              >
            </div>
          </div>
        </div>
      </div>

      <div class="prose-ksm reveal" data-delay="120">
        <h2 class="!mt-0">Motti Kallus, Founder</h2>
        <p>
          Motti Kallus is the founder of Kallus Strategic Management, where he works with business
          owners, entrepreneurs and professionals to better understand their financial position,
          strengthen how that position reads to a lender, and make sharper decisions around cash flow,
          debt and access to capital.
        </p>
        <p>
          With more than a decade of experience across operations, business strategy, sales and
          organizational growth, Motti has built his career around looking at the full picture,
          identifying what is holding a business back, and creating practical strategies that can
          actually be implemented.
        </p>
        <p>
          Before launching KSM he held senior operations and strategy roles — including leading
          operations for the South Florida Community Voice — managing teams, building sales and
          business-development systems, overseeing budgets and financial performance, and helping
          organizations improve both day-to-day operations and long-term growth.
        </p>

        <h3>How he approaches the work</h3>
        <p>
          The approach is straightforward: before applying for financing or making a major financial
          move, a client should understand exactly how their profile looks from the other side of the
          table. Motti helps clients identify the issues affecting their position, determine what
          should be addressed first, and build a clear strategy toward stronger cash flow and better
          financing options.
        </p>
        <p>
          He is most effective with owners who are making money but feel like their finances, debt,
          cash flow or financing structure are holding them back — the ones who need someone to look at
          the entire picture, work out what lenders are actually seeing, and produce a practical order
          of operations for what to fix first.
        </p>

        <h3>Why KSM exists</h3>
        <p>
          Based in Boca Raton, Florida, Motti founded KSM because too many business owners make major
          financial decisions without understanding how lenders view their profile. He wanted to give
          them something the financial world rarely offers: a clear, strategic view of where they
          stand, what is holding them back, and what to do next — before the next financial step, not
          after it.
        </p>

        <h3>Getting in touch</h3>
        <p>
          The fastest route is the <a href="/assessment">free Profile Score assessment</a> — twelve
          questions, about three minutes, and it gives you both something concrete to talk about. You
          can also <a href="/book">book a call</a>, <a href="/start">request a full profile</a>, or
          simply pick up the phone.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap mt-24">
    <div class="grid gap-10 rounded-[2rem] border border-line bg-cream p-8 sm:p-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      <div>
        <h2 class="text-[1.75rem] leading-tight sm:text-[2rem]">Talk to KSM directly.</h2>
        <p class="mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-ink-600">
          The fastest route is the profile request — it takes about a minute and tells us enough to have
          a useful first conversation. Email works too.
        </p>
        <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
          <a
            href={`mailto:${SITE.email}`}
            class="text-[0.9375rem] font-semibold text-brand-700 underline underline-offset-4 break-address"
            data-ev="email_click">{SITE.email}</a
          >
          <a
            href={`tel:${SITE.phone}`}
            class="text-[0.9375rem] font-semibold text-brand-700 underline underline-offset-4"
            data-ev="phone_click">{SITE.phoneDisplay}</a
          >
        </p>
      </div>
      <a href="/start" class="btn btn-primary flex-none" data-ev="about_cta_click">
        Start my profile <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <CTA />
</Base>
