---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { INSIGHTS, SITE } from '../data/site';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const meta = INSIGHTS.find((a) => a.slug === slug)!;
const related = INSIGHTS.filter((a) => a.slug !== slug).slice(0, 3);

const dateLabel = new Date(meta.date + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: meta.excerpt,
  datePublished: meta.date,
  articleSection: meta.category,
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
};
---

<Base
  title={`${meta.title} | KSM Insights`}
  description={meta.excerpt}
  path={`/insights/${slug}`}
  schema={[articleSchema]}
>
  <article>
    <header class="relative overflow-hidden border-b border-line bg-white">
      <div class="grid-bg pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="wrap relative py-14 md:py-20">
        <a
          href="/insights"
          class="inline-flex items-center gap-1.5 text-[0.8125rem] font-semibold text-brand-700 hover:gap-2.5"
        >
          <span aria-hidden="true">←</span> All insights
        </a>

        <p class="label mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-400">
          <span class="text-brand-700">{meta.category}</span>
          <span aria-hidden="true">·</span>
          <span>{meta.readTime}</span>
          <span aria-hidden="true">·</span>
          <time datetime={meta.date}>{dateLabel}</time>
        </p>

        <h1 class="mt-5 max-w-4xl text-[2rem] leading-[1.08] sm:text-[2.75rem]">{meta.title}</h1>
        <p class="mt-6 max-w-2xl text-[1.125rem] leading-relaxed text-ink-600">{meta.excerpt}</p>
      </div>
    </header>

    <div class="wrap mt-14 grid gap-14 lg:grid-cols-[minmax(0,44rem)_minmax(0,17rem)] lg:gap-20">
      <div>
      <div id="article-body" class="prose-ksm max-w-2xl">
        <slot />
      </div>

      <aside class="mt-16 max-w-2xl rounded-2xl border border-line bg-cream p-6">
        <p class="label text-ink-400">A note on scope</p>
        <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-600">
          This article is general information, not advice about your situation. KSM is not a lender,
          credit repair organization or debt settlement company, and does not guarantee financing,
          rates, credit limits or score changes. See our{' '}
          <a href="/disclosures" class="font-semibold text-brand-700 underline underline-offset-2">Disclosures</a>.
        </p>
      </aside>
      </div>

      <!-- Reading rail -->
      <aside class="hidden lg:block">
        <div class="sticky top-28 space-y-5">
          <nav id="toc-wrap" class="hidden border-l border-line pl-5" aria-label="On this page">
            <p class="label text-ink-400">In this piece</p>
            <ol id="article-toc" class="mt-4 space-y-2.5"></ol>
          </nav>

          <div class="rounded-2xl border border-line bg-cream p-5">
            <p class="label text-ink-400">Next step</p>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-700">
              See which of these patterns are actually operating in your position.
            </p>
            <a href="/start" class="btn btn-primary btn-sm mt-5 w-full" data-ev="article_rail_cta_click">
              Start my profile <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <script is:inline>
    (function () {
      var body = document.getElementById('article-body');
      var list = document.getElementById('article-toc');
      var wrap = document.getElementById('toc-wrap');
      if (!body || !list || !wrap) return;

      var heads = body.querySelectorAll('h2');
      if (heads.length < 2) return;
      wrap.classList.remove('hidden');

      var links = [];
      heads.forEach(function (h, i) {
        if (!h.id) {
          h.id =
            'section-' +
            (h.textContent || '')
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-|-$/g, '')
              .slice(0, 40) +
            '-' + i;
        }
        h.classList.add('scroll-mt-28');
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent;
        a.className =
          'block text-[0.8125rem] leading-snug text-ink-500 transition-colors hover:text-brand-700';
        li.appendChild(a);
        list.appendChild(li);
        links.push({ a: a, h: h });
      });

      function markCurrent() {
        var best = null;
        links.forEach(function (l) {
          if (l.h.getBoundingClientRect().top <= 140) best = l;
        });
        links.forEach(function (l) {
          var on = l === best;
          l.a.classList.toggle('text-brand-700', on);
          l.a.classList.toggle('font-semibold', on);
          l.a.classList.toggle('text-ink-500', !on);
        });
      }
      addEventListener('scroll', markCurrent, { passive: true });
      markCurrent();
    })();
  </script>

  <section class="wrap mt-20">
    <p class="eyebrow">Keep reading</p>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        related.map((r) => (
          <a href={`/insights/${r.slug}`} class="card card-hover group flex flex-col p-7">
            <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-brand-700">
              {r.category}
            </span>
            <h2 class="mt-3 text-[1.0625rem] leading-snug transition-colors group-hover:text-brand-700">
              {r.title}
            </h2>
            <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-500">{r.excerpt}</p>
            <span class="mt-5 text-[0.8125rem] font-semibold text-ink-400">{r.readTime}</span>
          </a>
        ))
      }
    </div>
  </section>

  <CTA
    title="Read enough. See your own numbers."
    body="Articles describe the patterns. A profile tells you which ones are actually operating in your position, and what to do first."
  />
</Base>
