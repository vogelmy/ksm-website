---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/business" */
  path?: string;
  /** Hide the sticky mobile CTA (used on /start) */
  hideMobileCta?: boolean;
  /** JSON-LD objects to embed */
  schema?: unknown[];
  /** Social share image, absolute or root-relative. */
  image?: string;
  /** og:type — "article" for Insights posts. */
  ogType?: string;
  /** Keep thin or post-conversion pages out of search results. */
  noindex?: boolean;
  /** Extra <meta> for articles. */
  publishedTime?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  hideMobileCta = false,
  schema = [],
  image = '/og.png',
  ogType = 'website',
  noindex = false,
  publishedTime,
} = Astro.props;

const origin = (Astro.site ?? new URL('https://ksm-strategy.com')).toString().replace(/\/$/, '');
const canonical = new URL(path, origin + '/').toString();
const ogImage = new URL(image, origin + '/').toString();

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': origin + '/#organization',
  name: SITE.name,
  alternateName: 'KSM',
  description: SITE.description,
  url: origin + '/',
  email: SITE.email,
  telephone: SITE.phone,
  image: origin + '/og.png',
  logo: origin + '/favicon.svg',
  founder: { '@type': 'Person', name: 'Motti Kallus', jobTitle: 'Founder' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Boca Raton',
    addressRegion: 'FL',
    addressCountry: 'US',
  },
  areaServed: { '@type': 'Country', name: 'United States' },
  serviceType: [
    'Financial profile analysis',
    'Cash flow optimization',
    'Debt structure strategy',
    'Financing readiness',
  ],
  knowsAbout: [
    'Cash flow analysis',
    'Debt structure',
    'Credit exposure',
    'Liquidity planning',
    'Financing readiness',
    'Business financial strategy',
  ],
  // Stated so search and AI answers do not mis-file KSM as a lender or credit repair firm.
  disambiguatingDescription:
    'KSM is an independent financial strategy consulting practice. It is not a lender, loan broker, credit repair organization, debt settlement company, credit reporting agency or investment adviser, and it does not guarantee financing outcomes.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="KSM — Kallus Strategic Management. Know exactly where your financial position stands."
    />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="KSM — Kallus Strategic Management. Know exactly where your financial position stands."
    />

    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}

    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content="Kallus Strategic Management" />

    <meta name="theme-color" content="#0F1D33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    />

    {
      SITE.ga4Id && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`} />
      )
    }
    {
      SITE.ga4Id && (
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${SITE.ga4Id}');`}
        />
      )
    }

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />)}
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink-900 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
      >Skip to content</a
    >

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Clears the sticky mobile CTA so it never covers the end of the footer. */}
    {!hideMobileCta && <div class="h-[76px] md:hidden" aria-hidden="true" />}

    {
      !hideMobileCta && (
        <div
          id="sticky-cta"
          class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-white/95 p-3 backdrop-blur transition-transform duration-300 md:hidden"
        >
          <div class="flex gap-2">
            <a
              href="/book"
              class="btn btn-ghost flex-1 px-3 text-[0.875rem]"
              data-ev="mobile_sticky_book_click"
            >
              Book a call
            </a>
            <a
              href="/start"
              class="btn btn-primary flex-1 px-3 text-[0.875rem]"
              data-ev="mobile_sticky_cta_click"
            >
              Get my profile
            </a>
          </div>
        </div>
      )
    }
    {
      !hideMobileCta && (
        <script is:inline>
          (function () {
            var bar = document.getElementById('sticky-cta');
            if (!bar) return;
            function toggle() {
              bar.classList.toggle('translate-y-full', window.scrollY < 520);
            }
            addEventListener('scroll', toggle, { passive: true });
            toggle();
          })();
        </script>
      )
    }

    <script is:inline>
      // ---- Centralized analytics utility -------------------------------
      window.ksm = window.ksm || {};
      window.ksm.track = function (event, props) {
        var payload = Object.assign({ event: event, path: location.pathname }, props || {});
        if (typeof window.gtag === 'function') window.gtag('event', event, payload);
        if (window.posthog && typeof window.posthog.capture === 'function')
          window.posthog.capture(event, payload);
        (window.dataLayer = window.dataLayer || []).push(payload);
      };
      window.ksm.track('page_view');

      // Declarative event tracking: any element with data-ev
      document.addEventListener('click', function (e) {
        var el = e.target instanceof Element ? e.target.closest('[data-ev]') : null;
        if (el) window.ksm.track(el.getAttribute('data-ev'), { label: (el.textContent || '').trim().slice(0, 60) });
      });

      // Scroll depth
      (function () {
        var fired = {};
        function onScroll() {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          if (max <= 0) return;
          var pct = (h.scrollTop / max) * 100;
          [25, 50, 75, 100].forEach(function (m) {
            if (pct >= m && !fired[m]) {
              fired[m] = true;
              window.ksm.track('scroll_' + m);
            }
          });
        }
        addEventListener('scroll', onScroll, { passive: true });
      })();

      // ---- Scroll reveal ------------------------------------------------
      (function () {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
        if (!els.length) return;

        function show(el, useDelay) {
          if (el.classList.contains('reveal-in')) return;
          var delay = useDelay ? parseInt(el.getAttribute('data-delay') || '0', 10) : 0;
          if (delay > 0) setTimeout(function () { el.classList.add('reveal-in'); }, delay);
          else el.classList.add('reveal-in');
        }

        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { show(el, false); });
          return;
        }

        // Sweep on load and on scroll. Deliberately not IntersectionObserver:
        // IO can skip above-the-fold nodes on first paint, which leaves content invisible.
        var pending = els.slice();
        var queued = false;

        function sweep() {
          queued = false;
          var vh = window.innerHeight || document.documentElement.clientHeight;
          var still = [];
          for (var i = 0; i < pending.length; i++) {
            var el = pending[i];
            var top = el.getBoundingClientRect().top;
            if (top < vh * 0.92) show(el, true);
            else still.push(el);
          }
          pending = still;
          if (!pending.length) {
            removeEventListener('scroll', request);
            removeEventListener('resize', request);
          }
        }

        function request() {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        }

        sweep();
        addEventListener('scroll', request, { passive: true });
        addEventListener('resize', request);
        // Belt and braces: fonts/images settling can shift layout.
        setTimeout(sweep, 400);
      })();
    </script>
  </body>
</html>
